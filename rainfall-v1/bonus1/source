#include <stdlib.h>
#include <string.h>
#include <unistd.h>

/*
 * bonus1 -- reconstructed from disassembly.
 *
 * n = atoi(argv[1]) is a SIGNED int. The bounds check "if (n > 9) return 1"
 * only rejects large POSITIVE values -- a negative n passes it. The copy size
 * is n*4, computed in 32 bits and then handed to memcpy() as a size_t.
 *
 * Choosing n = -1073741813 (0xC000000B):
 *   - as a signed int it is <= 9, so the check passes;
 *   - n*4 = 0xC000000B * 4 = 0x2C (44) once truncated to 32 bits.
 * So memcpy copies 44 bytes from argv[2] into a 40-byte-distant buffer, and
 * the 4 bytes at offset 40 land exactly on the stored copy of n. We set them
 * to "FLOW" (0x574f4c46), so the following "if (n == 0x574f4c46)" succeeds and
 * execl("/bin/sh", "sh", NULL) runs.
 */
int main(int argc, char **argv)
{
	int  n;
	char buf[40];   /* buf = esp+0x14 ; n = esp+0x3c == buf+40 */

	n = atoi(argv[1]);
	if (n > 9)
		return 1;
	memcpy(buf, argv[2], n * 4);      /* n<0 passes the check; n*4 wraps to 44 */
	if (n == 0x574f4c46)              /* "FLOW" -- written by the memcpy */
		execl("/bin/sh", "sh", NULL);
	return 0;
}
