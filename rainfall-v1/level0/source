#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>

/*
 * level0 -- reconstructed from the disassembly of the setuid binary.
 *
 * The binary is owned by user "level1" and has the setuid bit set, so while
 * it runs its effective uid/gid are level1's. If argv[1] converts to 423,
 * it locks that effective identity in with setresgid/setresuid (so the spawned
 * shell keeps level1's privileges) and execs /bin/sh. Otherwise it prints "No !".
 */
int main(int argc, char **argv)
{
	if (atoi(argv[1]) == 423)
	{
		char  *args[] = { "/bin/sh", NULL };
		gid_t  gid = getegid();
		uid_t  uid = geteuid();

		setresgid(gid, gid, gid);
		setresuid(uid, uid, uid);
		execv("/bin/sh", args);
	}
	else
	{
		fwrite("No !\n", 1, 5, stderr);
	}
	return 0;
}
