#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

/*
 * level2 -- reconstructed from disassembly.
 *
 * p() reads input with gets() into a stack buffer (unbounded -> overflow),
 * then inspects its OWN saved return address:
 *
 *     ret = *(unsigned int *)(ebp + 4);   // caller's return address
 *     *(unsigned int *)(ebp - 0xc) = ret; // <-- stored into a local at buf+64
 *     if ((ret & 0xb0000000) == 0xb0000000) { printf("%p", ret); _exit(1); }
 *
 * The 0xb0000000 test rejects any return address on the stack (0xbfff_xxxx)
 * AND in the shared libraries / libc (0xb7xx_xxxx on this box). That kills
 * both "return to shellcode on the stack" and "ret2libc into system()".
 *
 * But p() then strdup()s the buffer onto the HEAP (low address 0x0804_xxxx,
 * which passes the check) before returning. So we return into the heap copy
 * of our own shellcode.
 *
 * One catch: the line `*(ebp-0xc) = ret` writes the (attacker-chosen) return
 * address over bytes 64..67 of the buffer -- and therefore over the heap copy
 * too. So the shellcode cannot live across offset 64. We start the copy with a
 * short `jmp` that hops over the clobbered region to a clean copy of the
 * shellcode placed after the return-address slot.
 */
void p(void)
{
	char buf[64];
	unsigned int ret;

	fflush(stdout);
	gets(buf);
	ret = (unsigned int)__builtin_return_address(0);
	if ((ret & 0xb0000000) == 0xb0000000)
	{
		printf("(%p)\n", (void *)ret);
		_exit(1);
	}
	puts(buf);
	strdup(buf);
}

int main(void)
{
	p();
	return 0;
}
