#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/*
 * bonus2 -- reconstructed from disassembly.
 *
 * main() copies argv[1] (<=40 bytes) and argv[2] (<=32 bytes) into a 76-byte
 * buffer with strncpy (which does NOT NUL-terminate on a full copy), then
 * reads $LANG to pick a language and calls greetuser() with that buffer.
 *
 * greetuser() writes a fixed greeting into a 72-byte stack buffer and then
 * strcat()s the user string onto it -- with no size check. The greeting
 * length depends on the language:
 *     LANG unset / other : "Hello "          ( 7 bytes)
 *     LANG = "fi..."      : "Hyvää päivää "   (19 bytes)
 *     LANG = "nl..."      : "Goedemiddag! "  (14 bytes)
 * A longer greeting pushes the user data further, so the saved return address
 * is reached with fewer user bytes. With LANG=fi the return address lands on
 * bytes 18..21 of argv[2] (offset 58 of the combined argv1+argv2 buffer).
 */
int language;   /* global @ 0x8049988: 0 = EN, 1 = FI, 2 = NL */

void greetuser(char *name)
{
	char greeting[72];   /* ebp-0x48 */

	if (language == 1)
		memcpy(greeting, "Hyvää päivää ", 19);
	else if (language == 2)
		memcpy(greeting, "Goedemiddag! ", 14);
	else
		memcpy(greeting, "Hello ", 7);

	strcat(greeting, name);   /* <-- overflow, no bounds check */
	puts(greeting);
}

int main(int argc, char **argv)
{
	char  buf[76];   /* esp+0x50 */
	char *lang;

	if (argc != 3)
		return 1;

	memset(buf, 0, 76);
	strncpy(buf,      argv[1], 40);   /* not NUL-terminated on full copy */
	strncpy(buf + 40, argv[2], 32);

	lang = getenv("LANG");
	if (lang)
	{
		if (memcmp(lang, "fi", 2) == 0)
			language = 1;
		else if (memcmp(lang, "nl", 2) == 0)
			language = 2;
	}

	greetuser(buf);
	return 0;
}
